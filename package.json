{
  "name": "omnisynth",
  "productName": "OmniSynth",
  "version": "0.2.0",
  "description": "LLM-native DAW for electronic music: multimodal prompts in, synthesis out.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build --config vite.strudel.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "bun run build && node scripts/package-macos.mjs",
    "dist:unsigned": "bun run build && node scripts/package-macos.mjs --unsigned",
    "dist:dir": "bun run build && node scripts/package-macos.mjs --unsigned --dir",
    "test:release": "node --test scripts/release-config.test.mjs scripts/with-cleanup.test.mjs scripts/prepare-source.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "icons": "node scripts/generate-app-icons.mjs"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.5",
    "@strudel/web": "1.3.0",
    "hydra-synth": "^1.4.0",
    "solid-js": "1.9.18",
    "tone": "^15.1.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-solid": "^2.11.10"
  }
}
